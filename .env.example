# ======================================================
# asia.dot-bridal.com 環境変数テンプレート
# このファイルを .env.local にコピーして値を入力する
# .env.local は .gitignore に含まれており、Gitにはコミットしない
# ======================================================

# Sanity CMS（コンテンツ管理）
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_secret_token

# Resend（メール送信）
RESEND_API_KEY=re_xxxxxxxx

# WhatsApp Business番号（国番号込み、ハイフンなし）
NEXT_PUBLIC_WHATSAPP_NUMBER=85200000000

# LINE公式アカウントURL
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/@xxxxxxxx

# GA4 測定ID
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Maps Embed API（店舗ページの地図表示に使用）
# Google Cloud Console → Maps Embed API を有効化して取得
NEXT_PUBLIC_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY

# 本番URL
NEXT_PUBLIC_SITE_URL=https://asia.dot-bridal.com
